# ── URL Backend FastAPI ────────────────────────────────────────────────────
# Untuk development lokal:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Untuk production server (Cloudflare Tunnel):
# NEXT_PUBLIC_API_URL=https://verifin.octane.web.id

# ── Kredensial Halaman Admin (/admin) ──────────────────────────────────────
# Password untuk login ke panel moderasi admin
ADMIN_PASSWORD=verifin2026

# Secret key untuk sign session cookie admin (bebas acak)
ADMIN_SESSION_SECRET=verifin-admin-secret-change-me-2026

# Token proxy admin Next.js -> backend. Isi string acak panjang, sama persis di backend/.env.
ADMIN_API_TOKEN=
# Alamat backend yang dipakai server Next.js (proxy admin). Default: NEXT_PUBLIC_API_URL.
API_URL=http://127.0.0.1:8000
