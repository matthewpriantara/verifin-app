# ── LLM Provider (OpenAI-compatible) ───────────────────────────────────────
LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
LLM_API_KEY=sk-«your-api-key»
LLM_MODEL=your-model-name
LLM_VISION_MODEL=your-vision-model-name
LLM_TIMEOUT=120

# ── PostgreSQL (Supabase / self-hosted) ────────────────────────────────────
DATABASE_URL=postgresql://user:«password»@host:port/database

# ── Web Evidence Search ─────────────────────────────────────────────────────
# SearXNG self-hosted instance (primary multi-engine search)
SEARXNG_URL=http://localhost:8888

# ── Lightpanda Browser (headless, render JS) ───────────────────────────────
# Container: docker run -d --name lightpanda -p 127.0.0.1:9222:9222 lightpanda/browser:nightly
LIGHTPANDA_CONTAINER=lightpanda
LIGHTPANDA_CDP_URL=http://127.0.0.1:9222

# ── Redis (opsional) ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Debug (local only — print raw pipeline JSON, contains PII) ─────────────
VERIFIN_DEBUG_RAW_JSON=false
