# ── LLM Provider (OpenAI-compatible) ───────────────────────────────────────
LLM_BASE_URL=https://api.octane.web.id/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=ag/gemini-3.8-flash-high
LLM_TIMEOUT=120
LLM_EXTRACTOR_MODEL=ag/gemini-3.8-flash-high
LLM_VALIDATOR_MODEL=ag/gemini-3.8-flash-high

# ── Database PostgreSQL (Supabase / Local) — wajib diisi ────────────────────
# Direct: postgresql+psycopg2://postgres:«password»@db.«project».supabase.co:5432/postgres
# Pooler (IPv4/Session): postgresql+psycopg2://postgres.«project»:«password»@aws-0-«region».pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:«password»@db.«project».supabase.co:5432/postgres

# ── Web Evidence Search (SearXNG) ───────────────────────────────────────────
SEARXNG_URL=http://localhost:8888
SEARXNG_TIMEOUT=15
SEARXNG_CACHE_TTL=600
SEARXNG_MIN_INTERVAL=0.8

# ── OpenStreetMap / Nominatim (Geocoding Alamat) ─────────────────────────────
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSINT_TIMEOUT_SEC=15.0
OSINT_USER_AGENT=Verifin-OSINT-App/1.0 (gemastik; contact@verifin.app)

# ── Lightpanda Browser (headless, render JS) ────────────────────────────────
LIGHTPANDA_CONTAINER=lightpanda

# ── Upload Bukti Komunitas ──────────────────────────────────────────────────
UPLOAD_DIR=uploads/evidence
MAX_UPLOAD_SIZE_BYTES=5242880

# ── Keamanan & CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Redis (opsional) ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Debug (local only — print raw pipeline JSON, contains PII) ──────────────
VERIFIN_DEBUG_RAW_JSON=false
