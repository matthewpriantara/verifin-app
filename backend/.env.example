# ── LLM Provider Utama (Ollama / Local Server / Cloud) ─────────────────────
# Ollama di VPS (via Tailscale): http://100.118.206.100:11434/v1
# Ollama di lokal PC: http://localhost:11434/v1
LLM_BASE_URL=http://100.118.206.100:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:12b-it-qat
LLM_TIMEOUT=60
LLM_EXTRACTOR_MODEL=gemma4:12b-it-qat

# ── LLM Provider Cadangan (Fallback jika Utama down/timeout/gagal) ───────────
LLM_FALLBACK_BASE_URL=https://api.octane.web.id/v1
LLM_FALLBACK_API_KEY=your_fallback_api_key_here
LLM_FALLBACK_MODEL=ag/gemini-3.8-flash-medium
LLM_FALLBACK_TIMEOUT=60
LLM_FALLBACK_EXTRACTOR_MODEL=ag/gemini-3.8-flash-low

# ── Vision (pembacaan poster, mendampingi OCR) ───────────────────────────────
# Gemma 4 QAT tidak menerima gambar, jadi vision dikunci ke Gemini walau penalaran pakai Gemma.
# Kosongkan LLM_VISION_MODEL untuk mematikan (poster hanya dibaca OCR, tidak ada gambar ke cloud).
LLM_VISION_BASE_URL=https://api.octane.web.id/v1
LLM_VISION_API_KEY=your_fallback_api_key_here
LLM_VISION_MODEL=ag/gemini-3.8-flash-low

# ── Database PostgreSQL (Lokal / Self-hosted) — Wajib Diisi ─────────────────
# 1. Di dalam Docker container: postgresql+psycopg2://verifin:password@verifin-db:5432/verifin
# 2. Di host server lokal (Home/VPS): postgresql+psycopg2://verifin:password@127.0.0.1:5433/verifin
DATABASE_URL=postgresql+psycopg2://verifin:password@verifin-db:5432/verifin

# ── Web Evidence Search (SearXNG) ───────────────────────────────────────────
# Server VPS: https://search.hafidzprasetya.web.id
# Home Server lokal: http://localhost:8888
SEARXNG_URL=https://search.hafidzprasetya.web.id
SEARXNG_TIMEOUT=15
SEARXNG_CACHE_TTL=21600
SEARXNG_MIN_INTERVAL=0.8

# ── OpenStreetMap / Nominatim (Geocoding Alamat) ─────────────────────────────
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSINT_TIMEOUT_SEC=15.0
OSINT_USER_AGENT=Verifin-OSINT-App/1.0 (gemastik; contact@verifin.app)

# ── Upload Bukti Komunitas ──────────────────────────────────────────────────
UPLOAD_DIR=uploads/evidence
MAX_UPLOAD_SIZE_BYTES=5242880

# ── Keamanan & CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Debug & Admin Proxy ─────────────────────────────────────────────────────
VERIFIN_DEBUG_RAW_JSON=false
# Token proxy admin (wajib sama dengan ADMIN_API_TOKEN di frontend/.env)
ADMIN_API_TOKEN=your_admin_api_token_here
# Batas permintaan per IP per menit (Rate Limiting)
RATE_LIMIT_VERIFY_PER_MIN=10
RATE_LIMIT_REPORT_PER_MIN=5
