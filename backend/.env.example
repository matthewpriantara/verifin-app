# ── LLM Provider (OpenAI-compatible) ───────────────────────────────────────
LLM_BASE_URL=https://api.octane.web.id/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=ag/gemini-3.8-flash-high
LLM_VISION_MODEL=ag/gemini-3.8-flash-high
LLM_TIMEOUT=120

# ── Database PostgreSQL (Supabase / Local) — wajib diisi ────────────────────
# Direct: postgresql+psycopg2://postgres:«password»@db.«project».supabase.co:5432/postgres
# Pooler (IPv4/Session): postgresql+psycopg2://postgres.«project»:«password»@aws-0-«region».pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:«password»@db.«project».supabase.co:5432/postgres

# ── Web Evidence Search ─────────────────────────────────────────────────────
# SearXNG self-hosted instance (primary multi-engine search)
SEARXNG_URL=http://localhost:8888

# ── Lightpanda Browser (headless, render JS) ───────────────────────────────
# Container: docker run -d --name lightpanda -p 127.0.0.1:9222:9222 lightpanda/browser:nightly
LIGHTPANDA_CONTAINER=lightpanda
LIGHTPANDA_CDP_URL=http://127.0.0.1:9222

# ── Redis (opsional) ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Debug (local only — print raw pipeline JSON, contains PII) ─────────────
VERIFIN_DEBUG_RAW_JSON=false
