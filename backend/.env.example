LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-llm-model-name
LLM_TIMEOUT=60
LLM_EXTRACTOR_MODEL=your-extractor-model-name

LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_API_KEY=your-fallback-api-key-here
LLM_FALLBACK_MODEL=your-fallback-model-name
LLM_FALLBACK_TIMEOUT=60
LLM_FALLBACK_EXTRACTOR_MODEL=your-fallback-extractor-model-name

LLM_VISION_BASE_URL=http://localhost:11434/v1
LLM_VISION_API_KEY=your-vision-api-key-here
LLM_VISION_MODEL=your-vision-model-name

DATABASE_URL=postgresql+psycopg2://db_user:db_password@localhost:5432/verifin_db

SEARXNG_URL=https://search.yourdomain.com
SEARXNG_TIMEOUT=15
SEARXNG_CACHE_TTL=21600
SEARXNG_MIN_INTERVAL=1.0

GETCONTACT_URL=
GETCONTACT_TOKEN=your-token-here
GETCONTACT_TIMEOUT=8

NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSINT_TIMEOUT_SEC=15.0
OSINT_USER_AGENT=Verifin-App/1.0 (contact@yourdomain.com)

UPLOAD_DIR=uploads/evidence
MAX_UPLOAD_SIZE_BYTES=5242880

CORS_ORIGINS=*

VERIFIN_DEBUG_RAW_JSON=false
ADMIN_API_TOKEN=your-admin-api-token-here
RATE_LIMIT_VERIFY_PER_MIN=10
RATE_LIMIT_REPORT_PER_MIN=5
