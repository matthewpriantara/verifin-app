# ── Database PostgreSQL (Supabase / Local) — wajib diisi ────────────────────
# Direct: postgresql+psycopg2://postgres:«password»@db.«project».supabase.co:5432/postgres
# Pooler (IPv4/Session): postgresql+psycopg2://postgres.«project»:«password»@aws-0-«region».pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:«password»@db.«project».supabase.co:5432/postgres

# ── Redis (opsional) ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM (OpenAI-compatible) — wajib diisi ───────────────────────────────────
LLM_BASE_URL=https://api.octane.web.id/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=ag/gemini-3.8-flash-high
LLM_VISION_MODEL=ag/gemini-3.8-flash-high
LLM_TIMEOUT=120
