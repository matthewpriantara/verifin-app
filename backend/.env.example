# === LLM Provider (Omniroute / OpenAI-compatible) ===
LLM_BASE_URL=https://omniroute.pempekasliwongkito.my.id/v1
LLM_API_KEY=sk-your-llm-api-key
LLM_MODEL=antigravity/gemini-3.5-flash-high
LLM_VISION_MODEL=antigravity/gemini-3.5-flash-high
LLM_TIMEOUT=120

# === Database (PostgreSQL / Supabase Cloud) ===
DATABASE_URL=postgresql://postgres.your_db_instance:your_password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DB_USER=postgres.your_db_instance
DB_PASSWORD=your_password
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres

# === CORS ===
CORS_ORIGINS=*
